#pragma once
// ======================================================================================================================
// Open-chunk replay for flash_kda.fwd: a decode that is bitwise equal to the UNMODIFIED chunk-16 prefill.
//
// GENERATED by tools/gen_replay_kernel.py from csrc/smxx/fwd_kernel1.cuh and csrc/smxx/fwd_kernel2.cuh. The two blocks
// marked "verbatim" are byte-for-byte copies of the prefill kernels' arithmetic; the few edits are tagged [replay].
// Do not edit those blocks by hand: if the prefill kernel changes, regenerate (python tools/gen_replay_kernel.py .),
// otherwise decode and prefill stop agreeing bit for bit.
//
// Why this works. flash_kda.fwd walks a sequence in chunks of 16 tokens anchored at the sequence's first token. Inside a
// chunk, output row r only reads rows 0..r of k, v, g, beta, row r of q, and the bf16 state S at the chunk start: the
// gate cumsum is a sequential fold, L / Mqk / (I+L)^-1 are lower triangular, and S changes only when the chunk ends
// (K2 phase 6, rounded to bf16). A decode step for the token at chunk row r therefore re-runs the chunk arithmetic on
// rows 0..r of the open chunk (rows r+1..15 zero, as for a short last chunk) starting from S and emits row r: that row
// is bit-identical to row r of one flash_kda.fwd call over the whole sequence. When the open chunk reaches 16 rows the
// K2 state update runs exactly as in the prefill and S moves to the next chunk boundary.
//
// Launch: one CTA per (entry, head), 256 threads (K1's thread mapping); warps 0-3 run K2's MMA block, as in K2.
// Persistent state per (slot, head): S bf16 [V=128, K=128] (flash_kda.fwd's state layout), the raw k, v, g (bf16
// [16, 128]) and beta (bf16 [16]) of the open chunk's rows, and pos (rows in the open chunk; one copy per head, so each
// CTA reads and advances its own without a hand-off between the head CTAs of a sequence). q of earlier rows is not
// needed: only their own outputs read it, and those were emitted. A decode step is ONE launch of this kernel.
// ======================================================================================================================
#include "replay/replay.h"
#include "smxx/utils.cuh"
#include "smxx/fwd_kernel2.cuh"

#include <type_traits>

namespace flash_kda_replay {

@@K1_LAYOUTS@@

template <class Layouts, class K2L>
struct SharedStorageReplay {
    using BF16 = cutlass::bfloat16_t;
    using QKLayout = typename Layouts::QKLayout;
    using GLayout = typename Layouts::GLayout;
    using BetaSmemLayout = typename Layouts::BetaSmemLayout;
    using GTotalLayout = typename Layouts::GTotalLayout;
    using LMLayout = typename Layouts::LMLayout;
    using MMALayout = typename Layouts::MMALayout;
    using VOLayout = typename K2L::VOLayout;
    using StateSmemLayout = typename K2L::StateSmemLayout;

    // ---- K1 members, verbatim from SharedStorageK1 (fwd_kernel1.cuh:54-82) ----
@@K1_UNION@@

    // ---- K2 members (SharedStorageK2 with one input / output stage) ----
    alignas(128) cute::ArrayEngine<BF16, cute::cosize_v<StateSmemLayout>> state_acc;
    alignas(128) cute::ArrayEngine<BF16, cute::cosize_v<VOLayout>> v;
    alignas(128) cute::ArrayEngine<BF16, cute::cosize_v<VOLayout>> out;
};

template <int D, int CHUNK>
using ReplaySharedStorage = SharedStorageReplay<ReplayK1Layouts<D, CHUNK>, K2Layouts<D, CHUNK>>;

__device__ __forceinline__ void replay_cp_async_16(void* smem, void const* gmem) {
    const uint32_t s = static_cast<uint32_t>(__cvta_generic_to_shared(smem));
    asm volatile("cp.async.cg.shared.global [%0], [%1], 16;\n" :: "r"(s), "l"(gmem) : "memory");
}

__device__ __forceinline__ void replay_cp_async_commit_and_wait_all() {
    asm volatile("cp.async.commit_group;\n" ::: "memory");
    asm volatile("cp.async.wait_group 0;\n" ::: "memory");
}

#ifndef FLASH_KDA_REPLAY_MIN_BLOCKS
#define FLASH_KDA_REPLAY_MIN_BLOCKS 2   // CTAs per SM the register allocation must allow (occupancy only; no numerics)
#endif

template <int D, int CHUNK, int NumThreads>
__global__ void __launch_bounds__(NumThreads, FLASH_KDA_REPLAY_MIN_BLOCKS) _flash_kda_replay(ReplayParams const p) {
    static_assert(NumThreads == 256, "K1's thread mapping (16 threads per row x 16 rows) is copied verbatim");
    static_assert(CHUNK == 16 && D == 128, "flash_kda.fwd is CHUNK = 16, D = 128");
    using BF16 = cutlass::bfloat16_t;
    using Layouts = ReplayK1Layouts<D, CHUNK>;
    using MMALayout = typename Layouts::MMALayout;
    using QKLayout = typename Layouts::QKLayout;
    using GLayout = typename Layouts::GLayout;
    using BetaSmemLayout = typename Layouts::BetaSmemLayout;
    using GTotalLayout = typename Layouts::GTotalLayout;
    using LMLayout = typename Layouts::LMLayout;
    using LF32Layout = typename Layouts::LF32Layout;
    using K2L = K2Layouts<D, CHUNK>;
    using VOLayout = typename K2L::VOLayout;
    using TransposedMMALayout = typename K2L::TransposedMMALayout;
    using StateSmemLayout = typename K2L::StateSmemLayout;
    using TransposedStateSmemLayout = typename K2L::TransposedStateSmemLayout;
    static_assert(std::is_same_v<MMALayout, typename K2L::MMALayout>, "K1 and K2 tile layouts must agree");
    static_assert(std::is_same_v<LMLayout, typename K2L::LMLayout>, "K1 and K2 tile layouts must agree");
    static_assert(std::is_same_v<GTotalLayout, typename K2L::GTotalLayout>, "K1 and K2 tile layouts must agree");
    static_assert(std::is_same_v<BetaSmemLayout, typename K2L::BetaSmemLayout>, "K1 and K2 tile layouts must agree");

    extern __shared__ __align__(128) unsigned char shared_mem[];
    using SharedStorageT = SharedStorageReplay<Layouts, K2L>;
    SharedStorageT& shared_storage = *reinterpret_cast<SharedStorageT*>(shared_mem);

    const int entry = blockIdx.x;
    const int head_idx = blockIdx.y;
    const int H = p.H;
    const int slot = p.slot_ids ? p.slot_ids[entry] : entry;
    if (slot < 0) return;                        // padding entry
    if (slot >= p.num_slots) __trap();           // slot outside the state pool: stop instead of writing out of bounds
    // tokens of this entry: explicit (tok_start / tok_count) or the fixed-stride form [N, T] (decode)
    const int count = p.tok_count ? p.tok_count[entry] : p.tokens_per_entry;
    if (count <= 0) return;
    const int64_t tok0 = p.tok_start ? p.tok_start[entry] : int64_t(entry) * p.tokens_per_entry;
    const int64_t out0 = p.out_row ? p.out_row[entry] : tok0;
    const int64_t sh = int64_t(slot) * H + head_idx;
    int r0 = p.pos[sh];
    if (r0 < 0 || r0 >= CHUNK) __trap();         // corrupted state: stop instead of indexing out of bounds

    BF16* g_state = p.state + sh * (D * D);
    BF16* c_k = p.rows_k + sh * (CHUNK * D);
    BF16* c_v = p.rows_v + sh * (CHUNK * D);
    BF16* c_g = p.rows_g + sh * (CHUNK * D);
    BF16* c_beta = p.rows_beta + sh * CHUNK;
    const float scale = p.scale;
    const float gate_scale = p.gate_scale;

    // ---- S (bf16 [V, K] row-major in gmem) -> state_acc (StateSmemLayout), the element map of K2's TMA state load.
    //      Asynchronous (cp.async, 16 B = 8 consecutive K elements, contiguous in the K_INTER atom); the first K2 block
    //      waits for it, so the load overlaps the K1 arithmetic of the first segment.
    {
        Tensor s_acc = make_tensor(make_smem_ptr(shared_storage.state_acc.begin()), StateSmemLayout{});
        #pragma unroll
        for (int e = threadIdx.x * 8; e < D * D; e += NumThreads * 8) {
            const int vv = e / D, kk = e % D;
            replay_cp_async_16(&s_acc(vv, kk), g_state + e);
        }
    }

    // --- Compute a_log_exp (fwd_kernel1.cuh:258)
    float a_log_exp = expf(p.A_log[head_idx]);

    int consumed = 0;
    bool state_dirty = false;
    while (consumed < count) {
        const int take = min(CHUNK - r0, count - consumed);
        const int r_end = r0 + take;                  // rows 0 .. r_end-1 of the open chunk are valid
        const bool close_chunk = (r_end == CHUNK);    // this segment completes the chunk -> K2 state update

        // ---- stage the chunk tile (raw values, as K1 / K2 load them): rows < r0 from the row cache (q = 0, their
        //      outputs were emitted by earlier calls), rows r0 .. r_end-1 from the new tokens, rows >= r_end zero.
        {
            const int row = threadIdx.x / 16;
            const int c8 = (threadIdx.x % 16) * 8;
            uint4 wq = make_uint4(0u, 0u, 0u, 0u), wk = wq, wv = wq, wg = wq;
            if (row < r0) {
                wk = *reinterpret_cast<uint4 const*>(c_k + row * D + c8);
                wv = *reinterpret_cast<uint4 const*>(c_v + row * D + c8);
                wg = *reinterpret_cast<uint4 const*>(c_g + row * D + c8);
            } else if (row < r_end) {
                const int64_t t = tok0 + consumed + (row - r0);
                const int64_t off = (t * H + head_idx) * D + c8;
                wq = *reinterpret_cast<uint4 const*>(p.q + off);
                wk = *reinterpret_cast<uint4 const*>(p.k + off);
                wv = *reinterpret_cast<uint4 const*>(p.v + off);
                wg = *reinterpret_cast<uint4 const*>(p.g + off);
                if (!close_chunk) {   // the chunk stays open after this call: keep the raw row
                    *reinterpret_cast<uint4*>(c_k + row * D + c8) = wk;
                    *reinterpret_cast<uint4*>(c_v + row * D + c8) = wv;
                    *reinterpret_cast<uint4*>(c_g + row * D + c8) = wg;
                }
            }
            // q, k, g_bf16: QKLayout (row-major [CHUNK, D]), as K1's TMA writes them
            *reinterpret_cast<uint4*>(shared_storage.q.begin() + row * D + c8) = wq;
            *reinterpret_cast<uint4*>(shared_storage.k.begin() + row * D + c8) = wk;
            *reinterpret_cast<uint4*>(shared_storage.g_bf16.begin() + row * D + c8) = wg;
            // v: VOLayout, as K2's TMA writes it
            Tensor v_st = make_tensor(make_smem_ptr(shared_storage.v.begin()), VOLayout{});
            BF16 const* xv = reinterpret_cast<BF16 const*>(&wv);
            #pragma unroll
            for (int j = 0; j < 8; ++j) v_st(row, c8 + j) = xv[j];

            if (threadIdx.x < 32) {   // beta: chunk row i at entry i of the 32-entry tile (offset 0)
                const int i = threadIdx.x;
                BF16 b = BF16::bitcast(0);
                if (i < r0) {
                    b = c_beta[i];
                } else if (i < r_end) {
                    b = p.beta[(tok0 + consumed + (i - r0)) * H + head_idx];
                    if (!close_chunk) c_beta[i] = b;
                }
                shared_storage.beta.begin()[i] = b;
            } else if (threadIdx.x >= 128) {   // dt_bias shares its smem with g_total: reload it for every segment
                const int col = threadIdx.x - 128;
                shared_storage.dt_bias.begin()[col] = p.dt_bias[head_idx * D + col];
            }
        }
        __syncthreads();

        // ================= K1 arithmetic: verbatim fwd_kernel1.cuh:265-511 ([replay] edits tagged) =================
@@K1_MATH@@
        replay_cp_async_commit_and_wait_all();   // state_acc has landed (no-op after the first segment)
        __syncthreads();
        // ================= end of K1 arithmetic =================

        // ================= K2 MMA block: verbatim fwd_kernel2.cuh:463-732 ([replay] edits tagged) ==================
        // k_decayed, q_decayed, k_restored, g_total, INV, Mqk, beta_tile, beta_smem_offset are the K1 tensors above.
        if (compute_tid < 128) {
            Tensor v_tile = make_tensor(make_smem_ptr(shared_storage.v.begin()), VOLayout{});
            Tensor out_tile = make_tensor(make_smem_ptr(shared_storage.out.begin()), VOLayout{});
            Tensor s_acc = make_tensor(make_smem_ptr(shared_storage.state_acc.begin()), StateSmemLayout{});
            Tensor s_acc_T = make_tensor(make_smem_ptr(shared_storage.state_acc.begin()), TransposedStateSmemLayout{});
@@K2_BLOCK@@
        }
        __syncthreads();
        // ================= end of K2 MMA block =================

        // ---- emit rows r0 .. r_end-1 (K2's STORE warp copies a tail tile row by row the same way)
        {
            const int row = threadIdx.x / 16;
            const int c8 = (threadIdx.x % 16) * 8;
            if (row >= r0 && row < r_end) {
                Tensor s_out = make_tensor(make_smem_ptr(shared_storage.out.begin()), VOLayout{});
                alignas(16) BF16 tmp[8];
                #pragma unroll
                for (int j = 0; j < 8; ++j) tmp[j] = s_out(row, c8 + j);
                const int64_t orow = out0 + consumed + (row - r0);
                *reinterpret_cast<uint4*>(p.out + (orow * H + head_idx) * D + c8) = *reinterpret_cast<uint4 const*>(tmp);
            }
        }

        state_dirty = state_dirty || close_chunk;
        consumed += take;
        r0 = close_chunk ? 0 : r_end;
        __syncthreads();   // the next segment's staging overwrites the K1 union and the v / out tiles
    }

    // ---- pos of this (slot, head): rows in the open chunk after this call
    if (threadIdx.x == 0) p.pos[sh] = r0;

    // ---- state_acc -> S, only if a chunk was closed (otherwise S is still the open chunk's start state)
    if (state_dirty) {
        Tensor s_acc = make_tensor(make_smem_ptr(shared_storage.state_acc.begin()), StateSmemLayout{});
        for (int e = threadIdx.x * 8; e < D * D; e += NumThreads * 8) {
            alignas(16) BF16 x[8];
            const int vv = e / D, kk = e % D;
            #pragma unroll
            for (int j = 0; j < 8; ++j) x[j] = s_acc(vv, kk + j);
            *reinterpret_cast<uint4*>(g_state + e) = *reinterpret_cast<uint4 const*>(x);
        }
    }
}

}  // namespace flash_kda_replay
